#### Project-local xschem configuration for sky130-droop-detector (issue #27).
####
#### `detector_top.sch` instantiates the other blocks through their `.sym`
#### files in this directory, so xschem needs design/ on its symbol search
#### path. Sources the PDK's own xschemrc first; the PDK root comes from
#### $PDK_ROOT / $PDK (klt exports both), defaulting to ~/.volare / sky130A.

if {![info exists env(PDK_ROOT)] || $env(PDK_ROOT) eq {}} {
  set env(PDK_ROOT) [file normalize ~/.volare]
}
if {![info exists env(PDK)] || $env(PDK) eq {}} {
  set env(PDK) sky130A
}

set _sky130_rc $env(PDK_ROOT)/$env(PDK)/libs.tech/xschem/xschemrc
if {![file exists $_sky130_rc]} {
  puts stderr "sky130-droop-detector: no PDK xschemrc at $_sky130_rc"
} else {
  source $_sky130_rc
}
unset _sky130_rc

#### design/ appended after the PDK entries so a project symbol can never
#### shadow a sky130_fd_pr one.
set _design_dir [file normalize [file dirname [info script]]]
if {![info exists XSCHEM_LIBRARY_PATH] || $XSCHEM_LIBRARY_PATH eq {}} {
  set XSCHEM_LIBRARY_PATH $_design_dir
} else {
  append XSCHEM_LIBRARY_PATH ":$_design_dir"
}
unset _design_dir

set XSCHEM_START_WINDOW {}
