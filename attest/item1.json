          "klt",
          "netlist",
          "design/threshold_ref.sch",
          "-o",
          "design/threshold_ref.spice",
          "--block",
          "--check",
          "--pdk",
          "sky130A",
          "--rcfile",
          "design/xschemrc"
        ],
        "local_only": true
      }
    },
